{
  "version": "provisional-dt3-v2",
  "synthetic_only": true,
  "app": {
    "name": "Renewi Complaint Registration Assistant (PoC demonstrator)",
    "poc_mode": true,
    "supported_languages": ["nl", "en"]
  },
  "default_language": "nl",
  "taxonomy_version": "provisional-taxonomy-v1",
  "summary_template": "summary-v1",
  "summary": {
    "template_version": "summary-v1",
    "language_mode": "source",
    "fields": ["what", "where", "when", "impact"]
  },
  "classification": {
    "version": "classification-v1",
    "min_confidence": 0.5,
    "max_candidates": 3
  },
  "ai": {
    "provider": "mock",
    "model": "mock-keyword-v1",
    "timeout_s": 10,
    "max_retries": 1,
    "max_input_chars": 4000
  },
  "seed": {
    "anchor_date": "2026-10-28T12:00:00+00:00",
    "clock_mode": "fixed"
  },
  "baseline": {
    "current_process_seconds": null,
    "note": "No measured current-process baseline yet. Must be observed with a stopwatch before any time-saved claim."
  },
  "required_fields": ["description", "complaint_type", "root_cause", "channel"],
  "field_mapping_file": "backend/field_mapping.json",
  "repeat_rule": {
    "enabled": true,
    "lookback_days": 60,
    "match_keys": ["customer_id", "site_id"],
    "cause_mode": "level2",
    "eligible_statuses": ["open", "closed"],
    "missing_values": "no_match",
    "version": "draft-juul-v1",
    "last_updated": "2026-10-28T00:00:00+00:00"
  },
  "defaults": {
    "service": {"channel": "phone"},
    "billing": {"channel": "email"},
    "conduct": {"channel": "phone"}
  },
  "types": [
    {"id": "service", "en": "Collection service", "nl": "Inzamelservice", "description": "Problems with the collection service itself."},
    {"id": "billing", "en": "Billing", "nl": "Facturatie", "description": "Invoice and charge disputes."},
    {"id": "conduct", "en": "Conduct / other", "nl": "Gedrag / overig", "description": "Staff conduct and anything not fitting another type."}
  ],
  "root_causes": [
    {"id": "missed", "level1": "service", "level2": "missed_collection", "en": "Missed collection", "nl": "Niet ingezameld", "definition": "A planned collection did not take place.", "examples": "missed, not collected, niet geleegd, niet opgehaald"},
    {"id": "late", "level1": "service", "level2": "late_collection", "en": "Late collection", "nl": "Te late inzameling", "definition": "Collection occurred after the expected time.", "examples": "late, delayed, te laat, vertraagd"},
    {"id": "damage", "level1": "service", "level2": "container_damage", "en": "Container damage", "nl": "Containerschade", "definition": "Reported damage to a container.", "examples": "damaged, broken, kapot, beschadigd"},
    {"id": "access", "level1": "service", "level2": "blocked_access", "en": "Blocked access", "nl": "Toegang geblokkeerd", "definition": "Crew could not reach the container or site.", "examples": "blocked, locked gate, geblokkeerd, afgesloten"},
    {"id": "invoice", "level1": "billing", "level2": "incorrect_invoice", "en": "Incorrect invoice", "nl": "Onjuiste factuur", "definition": "A charge or invoice is disputed.", "examples": "invoice, charged, factuur, rekening"},
    {"id": "conduct", "level1": "conduct", "level2": "staff_conduct", "en": "Staff conduct", "nl": "Gedrag medewerker", "definition": "Reported interaction with staff.", "examples": "rude, behaviour, onbeleefd, gedrag"},
    {"id": "comms", "level1": "conduct", "level2": "poor_communication", "en": "Poor communication", "nl": "Slechte communicatie", "definition": "Customer was not informed or called back.", "examples": "no callback, not informed, geen terugbelverzoek, niet geïnformeerd"},
    {"id": "other", "level1": "other", "level2": "other", "en": "Other", "nl": "Overig", "definition": "No existing category fits; explanation required.", "examples": ""}
  ],
  "roles": {
    "employee": ["register", "read"],
    "lead": ["read", "analytics"],
    "admin": ["register", "read", "analytics", "configure", "evaluate", "audit"],
    "evaluator": ["read", "analytics", "evaluate"],
    "governance": ["read", "audit"],
    "viewer": ["read"]
  },
  "demo_users": [
    {"id": "demo.emp.a1", "name": "Demo Employee A1", "role": "employee", "group": "group_a"},
    {"id": "demo.emp.a2", "name": "Demo Employee A2", "role": "employee", "group": "group_a"},
    {"id": "demo.emp.b1", "name": "Demo Employee B1", "role": "employee", "group": "group_b"},
    {"id": "demo.emp.b2", "name": "Demo Employee B2", "role": "employee", "group": "group_b"},
    {"id": "demo.emp.c1", "name": "Demo Employee C1", "role": "employee", "group": "group_c"},
    {"id": "demo.lead", "name": "Demo Team Lead", "role": "lead", "group": "leads"},
    {"id": "demo.admin", "name": "Demo System Administrator", "role": "admin", "group": "admins"},
    {"id": "demo.evaluator", "name": "Demo Model Evaluator", "role": "evaluator", "group": "evaluators"},
    {"id": "demo.governance", "name": "Demo Privacy/Governance Reviewer", "role": "governance", "group": "governance"},
    {"id": "demo.viewer", "name": "Demo Viewer", "role": "viewer", "group": "viewers"}
  ],
  "provisional_meta": {
    "repeat_rule.lookback_days": {"description": "Days to look back for earlier complaints (boundary inclusive).", "provisional": true, "owner_to_confirm": "Juul (Renewi)", "updated": "2026-10-28"},
    "repeat_rule.match_keys": {"description": "Fields that must match for a potential repeat.", "provisional": true, "owner_to_confirm": "Juul (Renewi)", "updated": "2026-10-28"},
    "repeat_rule.cause_mode": {"description": "level1 or level2 root-cause match.", "provisional": true, "owner_to_confirm": "Juul (Renewi)", "updated": "2026-10-28"},
    "repeat_rule.eligible_statuses": {"description": "Previous complaint statuses considered.", "provisional": true, "owner_to_confirm": "Juul (Renewi)", "updated": "2026-10-28"},
    "repeat_rule.missing_values": {"description": "Handling when a match key is missing (no_match).", "provisional": true, "owner_to_confirm": "Juul (Renewi)", "updated": "2026-10-28"},
    "taxonomy": {"description": "Provisional synthetic taxonomy, not the official Renewi list.", "provisional": true, "owner_to_confirm": "Glenn / process owners", "updated": "2026-10-28"},
    "defaults": {"description": "Channel defaults per complaint type; illustrative only.", "provisional": true, "owner_to_confirm": "Complaint-system owner", "updated": "2026-10-28"},
    "classification.min_confidence": {"description": "Below this confidence no cause is preselected. Not a calibrated probability.", "provisional": true, "owner_to_confirm": "DigitalT3 / process owners", "updated": "2026-10-28"},
    "required_fields": {"description": "Mandatory registration fields.", "provisional": true, "owner_to_confirm": "Complaint-system owner", "updated": "2026-10-28"},
    "baseline.current_process_seconds": {"description": "Observed current-process duration; unset until measured.", "provisional": true, "owner_to_confirm": "Glenn", "updated": "2026-10-28"}
  }
}
