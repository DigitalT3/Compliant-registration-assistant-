# Copy to .env and adjust. Never commit real secrets.
# PoC database file (SQLite). Synthetic data only.
POC_DB_PATH=./poc.sqlite3
# Seed anchor: ISO date-time or "today". Default comes from config.json (seed.anchor_date).
# POC_SEED_ANCHOR=2026-10-28T12:00:00+00:00
# Business clock for repeat checks: fixed (seed anchor) or real.
# POC_CLOCK_MODE=fixed

# AI provider: mock (default, labelled MOCK) or live. Values must be requested from the user.
AI_PROVIDER=mock
AI_MODEL=mock-keyword-v1
AI_BASE_URL=
# Placeholder only. Request a real key from the user before using live mode.
AI_API_KEY=
AI_TIMEOUT_S=3.5
AI_MAX_RETRIES=0
AI_MAX_INPUT_CHARS=4000

# Sign-in: demo accounts (no password) are OFF unless set to 1. Create the first real admin with:
#   python -m backend.admin create-admin --email you@company.nl --name "Your Name"
POC_DEMO_MODE=0
# Optional: fixed secret for signing session tokens (otherwise one is generated and kept in the database).
# AUTH_SECRET=
